    HasBackgroundSprite: 1
    BackgroundSprite: {fileID: 21300000, guid: 29b1fbdcde6c9a64c9b2e22c510cb431, type: 3}
    Text: I have a meeting ,right now on my phone , maybe next time
  - SpeakerName: Co worker
